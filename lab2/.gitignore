##############################################
# ULTIMATE .gitignore
# Stack: Go + Python (uv) + JetBrains IDEs + OS junk
##############################################

##### ===== Go ===== #####

# Binaries / build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.a
*.test
*.out
bin/
build/
dist/

# Go workspace & modules
go.work
go.work.sum
vendor/

# Test / coverage
*.prof
*.pprof
*.cpu
*.mem
coverage.txt
coverage.html
*.cover
profile.cov

##### ===== Python ===== #####

# Virtual environments
.venv/
venv/
env/
ENV/
.venv*/

# Bytecode / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.pytype/
.ruff_cache/
.hypothesis/
.cache/

# Packaging / build
build/
dist/
pip-wheel-metadata/
*.egg-info/
*.egg
wheels/
MANIFEST

# uv
# (uv.lock SHOULD be committed — not ignored)

# Tests / coverage
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.nose2.*

# Jupyter
.ipynb_checkpoints/
*.ipynb_metadata

# Data / local artifacts
*.csv.tmp
*.tmp.csv
out/
output/
outputs/
results/
*.log

##### ===== JetBrains (IntelliJ / PyCharm / GoLand) ===== #####

.idea/
*.iml
*.ipr
*.iws

##### ===== VS Code ===== #####

.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
.history/

##### ===== OS junk ===== #####

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
Icon?
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.nfs*

##### ===== Misc / secrets ===== #####

# Environment / secrets — никогда не пушим
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets.*

# Editor & tool backups
*.sw[a-p]
*.swo
*.bak
*.orig
*.rej
*%/

# Logs
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker leftovers (если появится)
docker-compose.override.yml

# misc artifacts
*.sqlite
*.sqlite3
*.db